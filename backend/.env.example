# Copy this file to .env and fill in your own values. Never commit .env.

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection. The menu is read from the `menu_items` table (see
# ../menu_schema.sql for the schema + CSV import). Format:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Example for a local pgAdmin/Postgres install with the "restaurant" database:
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/restaurant

# --- Auth (required for production) -----------------------------------------
# Secret used to sign staff session tokens. Generate a long random value:
#   openssl rand -hex 32     (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# If left blank the server generates a temporary one and logs a warning, but
# then every staff member is logged out on each restart.
AUTH_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Add your deployed
# frontend URL here. Defaults to the local Vite/dev ports when unset.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-deployed-app.example.com

# --- Menu sync --------------------------------------------------------------
# How often (seconds) to re-read the menu from the database so edits made
# directly in pgAdmin propagate to open tabs. 0 disables it.
MENU_SYNC_INTERVAL_SECONDS=30
